; ==============================================================================
; Contact Graph Routing (CGR / SABR - CCSDS 734.3-B-1) over DTN - CDDL Specification
;
; Formalise les structures de données sérialisées en CBOR pour l'adaptation de
; l'algorithme spatial CGR (Contact Graph Routing / SABR - CCSDS 734.3-B-1) au-dessus de BPv7.
;
; Principes fondamentaux :
; 1. Routage déterministe par calendrier de contacts (Contact Plan).
; 2. Fenêtres spatio-temporelles : [start-time, end-time], débit et capacité résiduelle.
; 3. Temps de propagation one-way light time (OWLT) pour liaisons interplanétaires.
; 4. Acheminement au plus tôt (Earliest Delivery Time - EDT) avec respect du lifetime.
; ==============================================================================

; ------------------------------------------------------------------------------
; Définitions des clés de carte (Clés duales : entier CBOR compact / chaîne JSON)
; ------------------------------------------------------------------------------
k-message-type = 1 / "message-type"
k-issuer-eid = 2 / "issuer-eid"
k-timestamp-ms = 3 / "timestamp-ms"
k-payload = 4 / "payload"

k-contacts = 1 / "contacts"
k-ranges = 2 / "ranges"

k-contact-id = 1 / "contact-id"
k-from-eid = 2 / "from-eid"
k-to-eid = 3 / "to-eid"
k-start-time-ms = 4 / "start-time-ms"
k-end-time-ms = 5 / "end-time-ms"
k-data-rate-bps = 6 / "data-rate-bps"
k-max-capacity-bytes = 7 / "max-capacity-bytes"
k-confidence = 8 / "confidence"

k-owlt-ms = 5 / "owlt-ms"
k-contact-ids = 1 / "contact-ids"
k-reason = 2 / "reason"

; ------------------------------------------------------------------------------
; Message de contrôle CGR transporté dans le payload d'un bundle administratif
; ------------------------------------------------------------------------------
cgr-control-bundle = {
    k-message-type => cgr-message-type,
    k-issuer-eid => tstr,                  ; EID de l'autorité émettrice du calendrier
    k-timestamp-ms => uint,                ; Horloge DTN d'émission
    k-payload => cgr-payload               ; Charge utile selon le type
}

cgr-message-type = &(
    msg-contact-plan-update: 1, ; Ajout ou modification de contacts planifiés
    msg-contact-plan-revoke: 2, ; Annulation d'une fenêtre de contact (panne, etc.)
    msg-range-update: 3         ; Mise à jour de distance / délai OWLT
)

cgr-payload = (
    contact-plan-update-payload /
    contact-plan-revoke-payload /
    range-update-payload
)

; ------------------------------------------------------------------------------
; 1. MISE À JOUR DU CONTACT PLAN (Contact Plan Update)
; ------------------------------------------------------------------------------
contact-plan-update-payload = {
    k-contacts => [ * scheduled-contact ],
    ? k-ranges => [ * scheduled-range ]
}

scheduled-contact = {
    k-contact-id => uint,                  ; Identifiant unique de contact
    k-from-eid => tstr,                    ; Nœud émetteur
    k-to-eid => tstr,                      ; Nœud récepteur
    k-start-time-ms => uint,               ; Début de la fenêtre de visibilité
    k-end-time-ms => uint,                 ; Fin de la fenêtre de visibilité
    k-data-rate-bps => uint,               ; Débit de transmission en octets ou bits/s
    ? k-max-capacity-bytes => uint,        ; Capacité totale de la fenêtre
    ? k-confidence => float                ; Probabilité de tenue de contact [0.0 - 1.0]
}

scheduled-range = {
    k-from-eid => tstr,
    k-to-eid => tstr,
    k-start-time-ms => uint,
    k-end-time-ms => uint,
    k-owlt-ms => uint                      ; One-Way Light Time en millisecondes
}

; ------------------------------------------------------------------------------
; 2. RÉVOCATION DE CONTACT (Contact Revocation)
; ------------------------------------------------------------------------------
contact-plan-revoke-payload = {
    k-contact-ids => [ * uint ],
    k-reason => tstr
}

; ------------------------------------------------------------------------------
; 3. MISE À JOUR DE DISTANCE (Range Update)
; ------------------------------------------------------------------------------
range-update-payload = {
    k-ranges => [ * scheduled-range ]
}

; ------------------------------------------------------------------------------
; 4. ÉTAT ÉVALUÉ DANS L'ENVIRONNEMENT OPA (CGR Routing Table / Routes Cache)
; Modélise les métadonnées pré-calculées pour input.bundle et input.node.
; ------------------------------------------------------------------------------
cgr-computed-path = {
    destination-eid: tstr,
    next-hop-eid: tstr,
    first-contact-id: uint,
    earliest-delivery-time-ms: uint,
    remaining-capacity-bytes: uint,
    hops: uint,
    confidence: float
}
