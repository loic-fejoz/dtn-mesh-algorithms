package dtn.babel.constants

# Métrique infinie selon la RFC 8966 (Babel)
metric_infinity := 65535

# Durée de validité par défaut d'une route en millisecondes (Hold Time)
default_route_expiry_ms := 60000

# Préfixe de diffusion des messages de contrôle Babel
babel_broadcast_eid := "dtn://broadcast/babel"

# Préfixe conventionnel d'un îlot réseau AREDN
aredn_prefix := "dtn://aredn/"
