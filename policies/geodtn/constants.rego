package dtn.geodtn.constants

# Type de bloc d'extension de routage mesh (Type 200 - RFC 9171 plage privée)
block_type_mesh_routing := 200

# EID conventionnel pour la diffusion Geocast
geocast_broadcast_eid := "dtn://broadcast/geocast"

# Rayon par défaut d'un périmètre Geocast (en degrés approximatifs, 0.01 deg ~= 1.11 km)
default_geocast_radius_deg := 0.01
