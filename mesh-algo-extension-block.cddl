; ==============================================================================
; Generic DTN Mesh Routing - CDDL Specification
; 1. Format sur le câble (Wire Format BPv7 Extension Block - RFC 9171)
; 2. Schéma de l'Environnement d'Évaluation OPA (Policy Evaluation Context)
; Conforme à la RFC 8610 (CDDL)
; ==============================================================================

; ==============================================================================
; PARTIE 1 : FORMAT SUR LE CÂBLE (In-Flight Extension Block)
; Ne contient STRICTEMENT QUE les informations nécessaires au transfert
; d'intention de nœud à nœud. Aucune mesure locale (SNR mesuré, délai calculé)
; n'est sérialisée ici pour préserver la bande passante radio.
; ==============================================================================

mesh-routing-extension-block = [
    block-type-code: 200,                 ; Plage expérimentale IANA (192-255)
    block-number: uint,                   ; Numéro de bloc unique dans le bundle
    block-processing-control-flags: uint, ; Flags de traitement standard BPv7
    crc-type: uint,                       ; Type de CRC (0: None, 1: CRC16, 2: CRC32)
    ? crc-field: bytes,                   ; Champ CRC optionnel
    block-type-specific-data: bstr .cbor mesh-routing-data ; Données encapsulées
]

mesh-routing-data = {
    ? 1 => legacy-bridge-id: (bytes / uint), ; Empreinte externe (passerelle LoRa/AX.25 uniquement)
    ? 2 => replication-control,              ; Primitives de réplication et quotas
    ? 3 => trajectory-control,               ; Primitives de trajectoire ordonnée
    ? 4 => opportunistic-threshold: float,   ; Seuil d'utilité exigé par l'émetteur
    ? 5 => spatial-scope,                    ; Zone cible géographique (Geocasting)
    ? 6 => custom-attributes: { * (uint / tstr) => any } ; Attributs applicatifs étendus
}

; 1. Contrôle de Réplication (Spray & Wait, MaxProp, etc.)
replication-control = {
    1 => quota: uint,                      ; Nombre L de répliques attribuées au porteur
    ? 2 => mode: &(mode-source: 1, mode-binary: 2), ; Distribution unitaire ou binaire (L/2)
    ? 3 => phase: &(phase-disseminate: 1, phase-wait: 2), ; Phase active
    ? 4 => generation: uint                ; Niveau de génération de la copie
}

; 2. Contrôle de Trajectoire (Source Routing, Digipeating APRS WIDE n-N)
trajectory-control = {
    1 => path-elements: [* path-element],  ; Liste ordonnée des étapes
    2 => active-hop-index: uint,           ; Index 0-based pointant vers l'étape active
    ? 3 => allow-substitution: bool        ; Autorise la substitution par l'identifiant réel
}

path-element = strict-target / scoped-alias

strict-target = {
    1 => target-type: 1,                   ; 1 = Cible stricte
    2 => target-id: tstr,                  ; EID ou identifiant de nœud / callsign
    3 => completed: bool                   ; True si déjà validé/traversé
}

scoped-alias = {
    1 => target-type: 2,                   ; 2 = Alias générique
    2 => scope-name: tstr,                 ; Nom de l'alias (ex: "WIDE1", "WIDE2")
    3 => max-count: uint,                  ; Compte initial autorisé
    4 => remaining-count: uint,            ; Compte restant décrémenté
    5 => completed: bool,                  ; True lorsque remaining-count == 0
    ? 6 => serviced-by: tstr               ; Identifiant du relais ayant consommé l'étape
}

; 3. Délimitation Spatiale (Geocast, secours)
spatial-scope = {
    1 => latitude: float,                  ; Latitude du centre
    2 => longitude: float,                 ; Longitude du centre
    3 => radius-meters: uint,              ; Rayon de la zone cible
    ? 4 => altitude-meters: float          ; Altitude éventuelle
}

; ==============================================================================
; PARTIE 2 : ENVIRONNEMENT D'ÉVALUATION OPA (Policy Evaluation Context)
; Schéma du contexte JSON/CBOR injecté dans `input` lors de l'évaluation OPA.
; C'est ICI et UNIQUEMENT ICI que résident les mesures physiques radio (SNR, RSSI),
; l'état matériel du nœud (batterie, mémoire tampon) et la topologie des voisins.
; ==============================================================================

policy-evaluation-input = {
    bundle: bundle-context,                ; Bundle à évaluer (Primary + Extension Blocks)
    node: local-node-context,              ; État interne du nœud routeur local
    current_dtn_time_ms: uint,             ; Horloge courante DTN (ms depuis 2000-01-01)
    ? ingress: ingress-telemetry-context,  ; Présent lors de l'évaluation Ingress
    ? contact: contact-opportunity-context ; Présent lors de l'évaluation Contact CLA
}

bundle-context = {
    primary: {
        source: tstr,                      ; Source EID
        destination: tstr,                 ; Destination EID
        creation_timestamp: {
            time: uint,                    ; ms depuis époque DTN (0 si non synchronisé)
            sequence_number: uint          ; Compteur monotone
        },
        lifetime: uint,                    ; Durée de vie en ms
        processing_flags: { * tstr => any }
    },
    extension_blocks: [* {
        block_type: uint,
        ? payload: any,
        * any => any
    }]
}

local-node-context = {
    local_eid: tstr,                       ; EID du nœud local
    ? callsign: tstr,                      ; Indicatif radioamateur éventuel
    ? is_digipeater: bool,                 ; Rôle actif de répéteur
    ? allowed_destinations: [* tstr],      ; Whitelist de motifs d'EID acceptés
    ? blacklist_sources: [* tstr],         ; Blacklist d'EID sources bannis (anti-spam / DoS)
    ? seen_cache: [* any],                 ; Historique glissant des messages déjà vus
    ? supported_aliases: [* tstr],         ; Alias acceptés (ex: ["WIDE1", "WIDE2"])
    ? trapped_aliases: [* tstr],           ; Alias piégés (ex: ["WIDE3"])
    ? battery_level_pct: float,            ; Télémétrie d'énergie
    ? storage_used_bytes: uint,            ; Occupation mémoire tampon
    ? storage_capacity_bytes: uint,        ; Capacité totale
    ? cancelled_rebroadcasts: [* any],     ; Identifiants annulés pendant le backoff
    ? delivery_predictabilities: { * tstr => float } ; Vecteur de prévisibilité local P(a, b) (PRoPHET)
}

ingress-telemetry-context = {
    cla_type: tstr,                        ; "lora", "ax25", "tcpcl", "ble"
    ? peer_eid: tstr,                      ; Nœud amont immédiat
    ? snr_db: float,                       ; SNR mesuré par le modem radio récepteur
    ? rssi_dbm: float,                     ; RSSI mesuré au niveau physique
    ? frame_size_bytes: uint               ; Taille de trame reçue
}

contact-opportunity-context = {
    peer_eid: tstr,                        ; EID du contact détecté (ou "broadcast")
    cla_type: tstr,                        ; Adaptateur de couche de convergence
    is_broadcast: bool,                    ; Vrai si diffusion partagée
    ? link_quality_db: float,              ; Qualité estimée de la liaison vers ce pair
    ? mtu: uint,                           ; MTU de l'interface CLA
    ? held_bundle_ids: [* any],            ; Summary vector du pair
    ? peer_predictabilities: { * tstr => float } ; Vecteur P(b, d) reçu du pair lors du handshake PRoPHET
}
